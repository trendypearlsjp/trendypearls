# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudinary Image Upload API Configuration
# Get your cloud name and unsigned upload preset from https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=demo
VITE_CLOUDINARY_UPLOAD_PRESET=trendy_products
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# WhatsApp Shop Configuration
# Format with country code without plus or dashes, e.g., 919876543210 or 15551234567
VITE_WHATSAPP_NUMBER=15551234567
